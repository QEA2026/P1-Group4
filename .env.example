# Copy this file to .env and fill in real values. .env is gitignored.

POSTGRES_DB=expense_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

DB_HOST=postgres
DB_NAME=expense_manager
DB_USER=postgres
DB_PASSWORD=changeme
DB_PORT=5432
# Referenced by docker-compose.override.yml - required for local Postgres
# (no SSL support). On EC2, .env sets this to "require" instead (RDS).
DB_SSLMODE=disable

# Origin the manager-app frontend is served from; used for CORS.
# cant be left blank - an empty value crashes manager-app on boot.
# Local default matches the code's own fallback. On EC2 this should
# be the instance's current public IP instead.
FRONTEND_HOST=http://localhost:5500
